# Copy to .env (local dev) or set in the hosting dashboard.
# Base URL of the Sigmo V2 backend, WITHOUT a trailing /api.
VITE_API_BASE_URL=https://sigmo-backend-w4cx.onrender.com

# Supabase invite-only authentication (login page + protected API calls).
# The anon key is public by design; the service-role key must NEVER enter
# frontend code. Do not configure VITE_API_KEY or any Admin API key: human
# authorization uses the signed-in user's Bearer session and DB-backed role.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
