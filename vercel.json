{
  "framework": "vite",
  "buildCommand": "npx pnpm@12.6.0 --filter @workspace/voltguard run build",
  "outputDirectory": "artifacts/voltguard/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sigmo-backend-w4cx.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "npx pnpm@12.6.0 install --frozen-lockfile",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
