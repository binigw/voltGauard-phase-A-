# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Training-only datasets and reports are not needed by the API runtime.
# Keep ml/artifacts/v2_production/ because the decision engine loads these
# production ONNX models during startup.
ml/data/
ml/plots/
ml/reports/
ml/artifacts/v1_backup/
